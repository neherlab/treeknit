{
  "$schema": "https://unpkg.com/knip@6.38.0/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "dev/lints/oxlint-anti-slop/vendor/**/*.d.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "dev/lints/oxlint/__tests__/*.ts",
        "dev/lints/oxlint-anti-slop/effect/index.ts",
        "dev/lints/oxlint-anti-slop/**/*.test.ts"
      ],
      "project": ["*.ts", "dev/lints/oxlint/**/*.ts", "dev/lints/oxlint-anti-slop/**/*.ts"]
    },
    "packages/treeknit-wasm": {
      "entry": [],
      "project": []
    },
    "packages/web": {
      "entry": ["index.html!", "src/analysis/worker.ts!"],
      "project": ["src/**/*.{ts,tsx,css}!", "!src/**/__tests__/**!", "build/**/*.ts"],
      "ignoreDependencies": ["@svgr/plugin-jsx"]
    }
  }
}
