# Normalize line endings to LF for text files, on checkout and in the repo.
* text=auto eol=lf

# Patch files carry exact bytes; never convert their newlines.
*.patch -text
*.diff -text

# Lock files are regenerated by their tools, not edited by hand.
Cargo.lock linguist-generated=true
.config/mise.lock linguist-generated=true
bun.lock linguist-generated=true

# Reference fixtures are written by the Julia scripts in ref/.
fixtures/** linguist-generated=true

# Type declarations of the WebAssembly package, written by `just gen`.
packages/treeknit-wasm/pkg/treeknit_wasm.d.ts linguist-generated=true
