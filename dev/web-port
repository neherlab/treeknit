#!/usr/bin/env bash
#
# Usage: $0 <dev|prod>
#
# Print the port of the web app server of this checkout for a mode:
#
#   dev    Vite dev server: TREEKNIT_WEB_PORT when set, else 6180 + offset
#   prod   Server of the shipped build: TREEKNIT_SERVE_PORT when set, else 7180 + offset
#
# The offset (0-511) is derived from the checkout path, so the servers of
# parallel worktrees do not collide, and the two modes of one checkout run side
# by side.
#
set -euo pipefail
shopt -s inherit_errexit

dev_base_port=6180
prod_base_port=7180

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
offset="$(($(printf '%s' "${root}" | cksum | cut -d ' ' -f 1) % 512))"

case "${1:-}" in
dev) printf '%s\n' "${TREEKNIT_WEB_PORT:-$((dev_base_port + offset))}" ;;
prod) printf '%s\n' "${TREEKNIT_SERVE_PORT:-$((prod_base_port + offset))}" ;;
*)
  printf 'Usage: %s <dev|prod>\n' "$0" >&2
  exit 1
  ;;
esac
