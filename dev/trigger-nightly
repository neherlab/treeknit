#!/usr/bin/env bash
#
# Usage: $0 [options]
#
# Start a nightly in GitHub Actions: .github/workflows/release.yml on main
# deploys the web app to GitHub Pages when main has changed since the latest
# deployment. The "Run workflow" button of the workflow on GitHub takes the same
# option. Runs on the host and needs the GitHub CLI (gh), logged in or with
# GH_TOKEN set.
#
# Options:
#   -h, --help    Show this help
#   -f, --force   Deploy even when main has not changed since the latest deployment
#
# Examples:
#   $0
#   $0 --force
#
set -euo pipefail
trap "exit" INT

THIS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  local force="false"

  # shfmt:off
  while (($# > 0)); do
    case "${1}" in
    -h | --help)
      show_help
      exit 0
      ;;
    -f | --force)
      force="true"
      shift
      ;;
    *)
      printf "Unknown argument: %s\n" "${1}" >&2
      exit 1
      ;;
    esac
  done
  # shfmt:on

  command -v gh >/dev/null || {
    printf "Required command not found: gh\n" >&2
    exit 1
  }

  local repo
  repo="$(git -C "${THIS_DIR}" remote get-url origin | sed 's|.*github\.com[:/]||; s|\.git$||')"

  printf "Starting a nightly in %s (force: %s)\n" "${repo}" "${force}"
  gh workflow run release.yml --repo="${repo}" --ref=main -f force="${force}"
  printf "Started. Follow it at https://github.com/%s/actions/workflows/release.yml\n" "${repo}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
