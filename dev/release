#!/usr/bin/env bash
#
# Usage: $0 <version>
#
# Prepare a release and push it: set the workspace version, rename the
# '## Unreleased' section of CHANGELOG.md to '## <version>', commit, and push
# the commit to main and to the branch release together, after a confirmation.
# The push to release starts .github/workflows/release.yml, which runs the
# checks, builds the CLI for every release target, and tests the binaries on
# Linux, macOS, and Windows. Once they pass, it publishes the binaries as a
# GitHub release, which creates the tag <version>, with the section of the
# version in CHANGELOG.md as its notes, then to PyPI (pip install treeknit) and
# Docker Hub (neherlab/treeknit), and opens the pull request that updates the
# Bioconda recipe (conda install -c bioconda treeknit), which Bioconda
# maintainers merge. The script itself runs nothing heavy.
#
# Runs on the host, in the main checkout on the branch main, and needs git and
# yq; Docker only when the version differs from the workspace version, because
# cargo sets it in the build container. Write the '## Unreleased' section of
# CHANGELOG.md first; it may be the only uncommitted change.
#
# Arguments:
#   <version>   Version to release, MAJOR.MINOR.PATCH: the workspace version of
#               Cargo.toml while it is not released, or a newer one
#
# Options:
#   -h, --help  Show this help
#
# Examples:
#   $0 0.2.0
#
set -euo pipefail
trap "exit" INT

THIS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
ROOT="$(dirname "${THIS_DIR}")"

ask_yes_no() {
  local prompt="${1}" choice=""
  while true; do
    read -r -p "${prompt} [y/n] " choice
    case "${choice}" in
    y | Y) return 0 ;;
    n | N)
      printf "Aborted. The release commit stays local; remove it with: git reset --keep HEAD~1\n"
      exit 0
      ;;
    *) printf "Type 'y' or 'n'.\n" ;;
    esac
  done
}

fail() {
  printf "\n%s\n" "${1}" >&2
  exit 1
}

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  [[ "${1:-}" =~ ^(-h|--help)$ ]] && {
    show_help
    exit 0
  }
  if (($# != 1)); then
    show_help >&2
    exit 1
  fi

  local version="${1}"
  pushd "${ROOT}" >/dev/null

  printf "Pre-check: version format... "
  [[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "Invalid version '${version}': expected MAJOR.MINOR.PATCH"
  printf "✅\n"

  printf "Pre-check: required tools (git, yq)... "
  local tool
  for tool in git yq; do
    command -v "${tool}" >/dev/null || fail "Required command not found: ${tool}"
  done
  printf "✅\n"

  printf "Pre-check: main checkout on branch main... "
  [[ "$(git rev-parse --path-format=absolute --git-common-dir)" == "$(git rev-parse --path-format=absolute --git-dir)" ]] ||
    fail "Run the release in the main checkout, not in a worktree"
  local branch
  branch="$(git branch --show-current)"
  [[ "${branch}" == "main" ]] || fail "Not on the branch main (current: ${branch:-detached HEAD})"
  printf "✅\n"

  printf "Pre-check: no uncommitted changes except CHANGELOG.md... "
  if ! git diff --quiet -- ':!CHANGELOG.md' || ! git diff --cached --quiet -- ':!CHANGELOG.md'; then
    fail "Uncommitted changes outside CHANGELOG.md. Commit or stash them before releasing"
  fi
  printf "✅\n"

  printf "Pre-check: main contains origin/main... "
  git fetch --quiet origin
  git merge-base --is-ancestor origin/main HEAD || fail "Local main is behind origin/main or has diverged from it. Pull first"
  printf "✅\n"

  # release.yml fails on a push to release that is not a fast-forward.
  printf "Pre-check: main contains origin/release... "
  if git rev-parse --quiet --verify refs/remotes/origin/release >/dev/null; then
    git merge-base --is-ancestor origin/release HEAD || fail "origin/release is not an ancestor of main. Find out why before releasing"
  fi
  printf "✅\n"

  # The release of a version creates its tag.
  printf "Pre-check: version %s is not released (no tag %s on origin)... " "${version}" "${version}"
  [[ -z "$(git ls-remote --tags origin "refs/tags/${version}")" ]] || fail "Version ${version} is released: origin has the tag ${version}"
  printf "✅\n"

  # The workspace version itself is releasable while it has no tag: the check
  # above stops a second release of it.
  printf "Pre-check: version is the workspace version or newer... "
  local current
  current="$(yq -p toml -o yaml '.workspace.package.version' Cargo.toml)"
  [[ "$(printf "%s\n%s\n" "${current}" "${version}" | sort -V | tail -n 1)" == "${version}" ]] ||
    fail "Version ${version} is older than the workspace version ${current}"
  printf "✅ (%s -> %s)\n" "${current}" "${version}"

  printf "Pre-check: CHANGELOG.md has a '## Unreleased' section... "
  grep -qx '## Unreleased' CHANGELOG.md || fail "CHANGELOG.md has no '## Unreleased' line. Describe the changes under it and retry"
  printf "✅\n"

  if [[ "${version}" != "${current}" ]]; then
    command -v docker >/dev/null || fail "Required command not found: docker"
    printf "\nSetting the workspace version to %s...\n" "${version}"
    dev/docker/run cargo set-version --workspace --offline "${version}"
    [[ "$(yq -p toml -o yaml '.workspace.package.version' Cargo.toml)" == "${version}" ]] || fail "Failed to set the version in Cargo.toml"
  fi

  printf "Renaming '## Unreleased' to '## %s' in CHANGELOG.md... " "${version}"
  sed "s/^## Unreleased\$/## ${version}/" CHANGELOG.md >CHANGELOG.md.new
  mv CHANGELOG.md.new CHANGELOG.md
  grep -qx "## ${version}" CHANGELOG.md || fail "Failed to update CHANGELOG.md"
  printf "✅\n"

  printf "\nRelease commit:\n\n"
  git --no-pager diff -- Cargo.toml Cargo.lock CHANGELOG.md
  printf "\n"

  printf "Committing... "
  git add Cargo.toml Cargo.lock CHANGELOG.md
  git commit --quiet -m "chore: release ${version}"
  printf "✅\n"

  printf "\nRelease %s is ready locally.\n" "${version}"
  ask_yes_no "Push the release commit to main and release on origin?"
  git push --atomic --quiet origin main main:release
  printf "Pushed. GitHub Actions now checks, builds, and publishes %s: https://github.com/%s/actions/workflows/release.yml\n" \
    "${version}" "$(git remote get-url origin | sed 's|.*github\.com[:/]||; s|\.git$||')"
  popd >/dev/null
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
