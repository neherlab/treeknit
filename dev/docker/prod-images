#!/usr/bin/env bash
#
# Usage: $0 [options]
#
# Build the production images neherlab/treeknit for linux/amd64 and
# linux/arm64 from the Linux release binaries in .out/: Debian with the glibc
# build (dev/docker/prod-debian.dockerfile), Alpine and scratch with the static
# musl build (prod-alpine, prod-scratch), on every base of
# dev/docker/prod-bases.json, each pinned to its digest. Without options, the
# images are built for both platforms and kept in the build cache only.
#
# Tags, for version 1.0.0 with Debian 13 and Alpine 3.24 as the newest bases:
#   1.0.0-debian13 latest-debian13 debian13 1-debian13 latest-1-debian13
#                                      each base, here Debian 13
#   1.0.0-debian latest-debian debian 1-debian latest-1-debian
#                                      the newest base of each distribution
#   1.0.0 latest 1                     the newest Debian
# A pre-release version such as 1.1.0-beta.1 gets the tags of its type (beta)
# and prerelease instead of latest.
#
# Every build uses one docker-container builder, treeknit-prod, so a push after
# --run reuses the layers of the tested builds. The binaries are staged with
# mode 0755 under .out/docker/<amd64|arm64>/<gnu|musl>/. The log of each build
# goes to tmp/docker-prod/.
#
# Runs on the host and needs Docker with buildx, QEMU user emulation for the
# platform that the host does not run (binfmt_misc), yq, jq, and the binaries
# treeknit-{x86_64,aarch64}-unknown-linux-{gnu,musl} in .out/.
#
# Options:
#   -h, --help  Show this help
#   --run       Load each platform into Docker and run `treeknit --version` in
#               every image
#   --push      Push the images of both platforms to Docker Hub (log in first);
#               with --run, only after every image ran
#
# Examples:
#   $0 --run
#   $0 --run --push
#
set -euo pipefail
trap "exit" INT

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"

IMAGE="neherlab/treeknit"
PLATFORMS="linux/amd64,linux/arm64"
BUILDER="treeknit-prod"
DISTROS=(debian alpine scratch)
LOG_DIR="tmp/docker-prod"

# Print the tags of an image variant for a suffix such as debian13 or alpine.
# Reads IMAGE, release_type, version, and version_major.
generate_tags() {
  local suffix="${1}"
  local tags=""

  tags="${IMAGE}:${release_type}-${suffix}"
  tags="${tags} ${IMAGE}:${version}-${suffix}"

  if [[ "${release_type}" == "latest" ]]; then
    tags="${tags} ${IMAGE}:${suffix}"
    tags="${tags} ${IMAGE}:${release_type}-${version_major}-${suffix}"
    tags="${tags} ${IMAGE}:${version_major}-${suffix}"
  else
    tags="${tags} ${IMAGE}:prerelease-${suffix}"
    tags="${tags} ${IMAGE}:prerelease-${version_major}-${suffix}"
  fi

  printf "%s" "${tags}"
}

# Print the tags without a base suffix, of the default image.
# Reads IMAGE, release_type, version, and version_major.
generate_bare_tags() {
  local tags=""

  tags="${IMAGE}:${release_type}"
  tags="${tags} ${IMAGE}:${version}"

  if [[ "${release_type}" == "latest" ]]; then
    tags="${tags} ${IMAGE}:${version_major}"
  else
    tags="${tags} ${IMAGE}:prerelease"
    tags="${tags} ${IMAGE}:prerelease-${version_major}"
  fi

  printf "%s" "${tags}"
}

# Print one line per image variant: distribution, base tag (empty for
# scratch), base image reference with digest (empty for scratch), and whether
# it is the newest base of its distribution, separated by '|'. A tab would not
# work: read merges consecutive tabs, so an empty field would vanish.
variants() {
  local distro
  for distro in "${DISTROS[@]}"; do
    if [[ "${distro}" == scratch ]]; then
      printf 'scratch|||true\n'
      continue
    fi
    jq -r --arg distro "${distro}" \
      '.bases[$distro] | to_entries[] | [$distro, .value.tag, "\($distro):\(.value.tag)@\(.value.digest)", (.key == 0 | tostring)] | join("|")' \
      dev/docker/prod-bases.json
  done
}

# Build one image variant with an output option of buildx: --load for one
# platform, --push or --output=type=cacheonly for both.
build_one() {
  local output="${1}" platform="${2}" distro="${3}" tag="${4}" base="${5}" newest="${6}"

  local tags=""
  [[ -z "${tag}" ]] || tags="$(generate_tags "${distro}${tag}")"
  [[ "${newest}" != "true" ]] || tags="${tags} $(generate_tags "${distro}")"
  [[ "${newest}" != "true" || "${distro}" != debian ]] || tags="${tags} $(generate_bare_tags)"

  local args=() name
  for name in ${tags}; do
    args+=(--tag="${name}")
  done
  [[ -z "${base}" ]] || args+=(--build-arg="BASE_IMAGE=${base}")

  docker buildx build \
    --builder="${BUILDER}" \
    --platform="${platform}" \
    "${output}" \
    --file="dev/docker/prod-${distro}.dockerfile" \
    --progress=plain \
    "${args[@]}" \
    .
}

# Build every image variant in parallel; fail when any build fails.
build_all() {
  local output="${1}" platform="${2}"
  local pids=() labels=() logs=() distro tag base newest label list

  list="$(variants)"
  mkdir -p "${LOG_DIR}"
  while IFS='|' read -r distro tag base newest; do
    label="${distro}${tag}"
    labels+=("${label}")
    logs+=("${LOG_DIR}/${label}-${platform//\//-}.log")
    build_one "${output}" "${platform}" "${distro}" "${tag}" "${base}" "${newest}" >"${logs[${#logs[@]} - 1]}" 2>&1 &
    pids+=("$!")
  done <<<"${list}"
  printf 'Building %s image variants for %s (%s); logs in %s/\n' "${#pids[@]}" "${platform}" "${output}" "${LOG_DIR}" >&2

  local failed=0 i
  for i in "${!pids[@]}"; do
    if wait "${pids[${i}]}"; then
      printf 'Built %s\n' "${labels[${i}]}" >&2
    else
      printf 'FAIL %s (%s)\n' "${labels[${i}]}" "${logs[${i}]}" >&2
      failed=$((failed + 1))
    fi
  done
  if ((failed > 0)); then
    printf '%s builds failed\n' "${failed}" >&2
    exit 1
  fi
}

# Run `treeknit --version` in the loaded image of every variant.
run_all() {
  local platform="${1}" distro tag base newest name output list failed=0

  list="$(variants)"
  while IFS='|' read -r distro tag base newest; do
    name="${IMAGE}:${release_type}-${distro}${tag}"
    if output="$(docker run --rm --platform="${platform}" "${name}" treeknit --version 2>&1)"; then
      printf 'PASS %s (%s): %s\n' "${name}" "${platform}" "${output}" >&2
    else
      printf 'FAIL %s (%s): %s\n' "${name}" "${platform}" "${output}" >&2
      failed=$((failed + 1))
    fi
  done <<<"${list}"
  if ((failed > 0)); then
    printf '%s images failed to run\n' "${failed}" >&2
    exit 1
  fi
}

# Copy the binaries to the paths that TARGETARCH selects in the Dockerfiles.
stage_binaries() {
  local arch target libc source
  for arch in amd64 arm64; do
    target="x86_64"
    [[ "${arch}" == amd64 ]] || target="aarch64"
    for libc in gnu musl; do
      source=".out/treeknit-${target}-unknown-linux-${libc}"
      if [[ ! -f "${source}" ]]; then
        printf 'Missing %s; build it with dev/cross/build or download it from the release\n' "${source}" >&2
        exit 1
      fi
      mkdir -p ".out/docker/${arch}/${libc}"
      install -m 0755 "${source}" ".out/docker/${arch}/${libc}/treeknit"
    done
  done
}

main() {
  local run="" push=""
  while (($# > 0)); do
    case "${1}" in
    -h | --help)
      sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
      exit 0
      ;;
    --run) run=1 ;;
    --push) push=1 ;;
    *)
      printf 'Unknown argument: %s\n' "${1}" >&2
      exit 1
      ;;
    esac
    shift
  done

  local tool
  for tool in docker jq yq; do
    command -v "${tool}" >/dev/null || {
      printf 'Required command not found: %s\n' "${tool}" >&2
      exit 1
    }
  done

  cd "${root}"
  version="$(yq -p toml -o yaml '.workspace.package.version' Cargo.toml)"
  version_major="${version%%.*}"
  release_type="latest"
  if [[ "${version}" == *-* ]]; then
    release_type="${version#*-}"
    release_type="${release_type%%.*}"
  fi

  stage_binaries
  docker buildx inspect "${BUILDER}" >/dev/null 2>&1 || docker buildx create --name="${BUILDER}" --driver=docker-container >/dev/null

  # A docker-container builder loads one platform at a time.
  if [[ -n "${run}" ]]; then
    local platform
    for platform in ${PLATFORMS//,/ }; do
      build_all --load "${platform}"
      run_all "${platform}"
    done
  fi
  if [[ -n "${push}" ]]; then
    build_all --push "${PLATFORMS}"
  elif [[ -z "${run}" ]]; then
    build_all --output=type=cacheonly "${PLATFORMS}"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
