  "type": "module",
  "scripts": {
    "build:web": "bun run --cwd packages/web build",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.reportsDirectory=tmp/coverage/ts --coverage.include=\"packages/*/src/**/*.{ts,tsx}\"",
    "dev:web": "bun run --cwd packages/web dev",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "knip": "knip --config .config/knip.json",
    "knip:production": "knip --config .config/knip.json --production",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "preview:web": "bun run --cwd packages/web preview",
    "test": "vitest run",
    "typecheck:packages": "bun run --cwd packages/web typecheck",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:vendor": "tsc -p dev/lints/oxlint-anti-slop/tsconfig.json"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
